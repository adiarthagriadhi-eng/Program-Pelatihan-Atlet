# Salin file ini menjadi ".env.local" lalu isi dengan data koneksi database
# hosting Anda (Supabase, Railway, Neon, dll). JANGAN commit file .env.local
# ke git — file itu sudah otomatis diabaikan lewat .gitignore.

# Connection string PostgreSQL, formatnya:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Contoh Supabase: postgresql://postgres:xxxx@db.xxxx.supabase.co:5432/postgres
# Contoh Railway:  postgresql://postgres:xxxx@xxxx.railway.app:5432/railway
DATABASE_URL=

# Sebagian besar hosting (Supabase/Railway/Neon) mewajibkan SSL.
# Biarkan baris ini terhapus/di-comment agar SSL aktif (default).
# Set ke "false" hanya jika Anda menjalankan PostgreSQL lokal tanpa SSL.
# DATABASE_SSL=false
